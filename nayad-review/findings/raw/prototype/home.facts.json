          "mainEntity": [
            {
              "@type": "Question",
              "name": "NAYAD ашиглахад төлбөртэй юу?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Үнийн төлөвлөгөө удахгүй зарлагдана. Мэдэгдэл авахыг хүсвэл «Үнэ» хэсэгт утас эсвэл имэйлээ үлдээгээрэй."
              }
            },
            {
              "@type": "Question",
              "name": "App Store эсвэл Play Store-оос татах шаардлагатай юу?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Үгүй. NAYAD хөтөч дээр ажилладаг. Хүсвэл утасныхаа нүүр дэлгэцэнд нэмээд апп шиг нээж болно."
              }
            },
            {
              "@type": "Question",
              "name": "Компьютер дээр ашиглаж болох уу?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Болно. Компьютер, таблет, утасны аль ч хөтчөөр nayad.store руу ороод нэвтэрнэ."
              }
            },
            {
              "@type": "Question",
              "name": "Өмнө нь имэйлээр бүртгүүлсэн. Яаж нэвтрэх вэ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Нэвтрэх хуудаснаас имэйлээр нэвтрэх сонголтыг дараад өмнөх имэйл, нууц үгээрээ орно."
              }
            },
            {
              "@type": "Question",
              "name": "Нууц үгээ мартсан бол яах вэ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Нэвтрэх хуудсан дээрх нууц үг сэргээх холбоосыг дарж, шинэ нууц үг үүсгэнэ."
              }
            },
            {
              "@type": "Question",
              "name": "Миний мэдээллийг өөр хүн харах уу?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Таны оруулсан өглөг, падаан, төлөлт зөвхөн таны бүртгэлээр нэвтэрсэн үед харагдана."
              }
            }
          ]
